{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "maple",
    "name": "Dhow",
    "description": "Dhow is a local-first, open-source AI coworker. It turns your email, meetings and notes into a knowledge graph on your own machine, and acts on it.",
    "favicon": "/favicon.ico",
    "colors": {
      "primary": "#6366F1",
        "light": "#6366F1",
        "dark": "#6366F1"
    },
    "icons": {
      "library": "fontawesome"
    },
    "navigation": {
      "groups": [
        {
          "group": "Getting Started",
          "pages": [
            "docs/getting-started/introduction",
            "docs/getting-started/quickstart"
          ]
        },
        {
          "group": "Development",
          "pages": ["docs/development/contribution-guide", "docs/getting-started/license"]
        }
      ]
    },
    "background": {
      "decoration": "gradient",
      "color": {
        "light": "#FFFFFF",
        "dark": "#0D0A09"
      }
    },
    "navbar": {
      "primary": {
        "type": "button",
        "label": "Try Dhow",
        "href": "https://github.com/SajmustafaKe/Dhow"
      }
    },
    "footer": {
      "socials": {
        "github": "https://github.com/SajmustafaKe/Dhow"
      }
    },
    "contextual": {
      "options": [
        "copy",
        "view",
        "chatgpt",
        "claude"
      ]
    }
  }

